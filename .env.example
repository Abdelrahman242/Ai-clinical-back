# Supabase Postgres Session Pooler connection string.
# Copy it from Supabase Dashboard -> Connect -> Session pooler (port 5432).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<database-password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Optional local-development fallback. SUPABASE_DB_URL takes precedence.
# DATABASE_URL=sqlite:///./clinical_rag.db

AUTO_INGEST_ENABLED=true
AUTO_INGEST_INTERVAL_SECONDS=15
