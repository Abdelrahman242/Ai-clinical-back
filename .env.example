# Supabase Postgres Session Pooler connection string.
# Copy it from Supabase Dashboard -> Connect -> Session pooler (port 5432).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<database-password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Optional local-development fallback. SUPABASE_DB_URL takes precedence.
# DATABASE_URL=sqlite:///./clinical_rag.db

AUTO_INGEST_ENABLED=true
AUTO_INGEST_INTERVAL_SECONDS=15

# Semantic retrieval settings.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_NORMALIZE=true
ENABLE_QUERY_EXPANSION=false

# LLM provider: auto prefers Groq when GROQ_API_KEY exists (legacy behavior).
LLM_PROVIDER=auto
GROQ_MODEL=openai/gpt-oss-120b
# Only used when LLM_PROVIDER=openai or when Groq is unavailable.
OPENAI_MODEL=gpt-5-mini
# Optional; leave unset for the official OpenAI API.
# OPENAI_API_BASE=https://your-compatible-provider.example/v1

# Keep this stable across deploys/restarts. Generate a long random value.
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
